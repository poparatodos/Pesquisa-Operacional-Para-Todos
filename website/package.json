{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vite-node scripts/validate-content.ts",
    "e2e": "start-server-and-test preview http://localhost:4173 \"cypress run\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@unhead/vue": "^2.1.17",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.21.1",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vite-node": "^6.0.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
